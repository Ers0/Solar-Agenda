{
  "manifest_version": 3,
  "name": "TARS Vision Bridge",
  "version": "1.2.86",
  "description": "Solar Agenda TARS Vision Bridge with passive Observer Mode, cross-site workflow learning, Hyperflow memory, Hoymiles automation, page vision, and safety controls.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs",
    "alarms",
    "notifications"
  ],
  "host_permissions": [
    "https://conversas.hyperflow.global/*",
    "https://global.hoymiles.com/*",
    "https://solar-agenda.vercel.app/*",
    "http://localhost:3000/*",
    "https://*.run.app/*",
    "https://*.aistudio.google.com/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://solar-agenda.vercel.app/*",
        "http://localhost:3000/*",
        "https://*.run.app/*",
        "https://*.aistudio.google.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://conversas.hyperflow.global/*"
      ],
      "js": [
        "hyperflow_boot.js",
        "hyperflow.js",
        "observer.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "https://global.hoymiles.com/*"
      ],
      "js": [
        "hoymiles.js",
        "observer.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_title": "Ask TARS about this page",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  }
}
