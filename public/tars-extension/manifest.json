{
  "manifest_version": 3,
  "name": "TARS Vision Bridge",
  "version": "1.2.37",
  "description": "TARS Vision Bridge with Hyperflow memory, Hoymiles installer automation, SLA webhook layer, and diagnostics.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://conversas.hyperflow.global/*",
    "https://global.hoymiles.com/*",
    "https://solar-agenda.vercel.app/*",
    "http://localhost:3000/*",
    "https://*.run.app/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://solar-agenda.vercel.app/*",
        "http://localhost:3000/*",
        "https://*.run.app/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://conversas.hyperflow.global/*"
      ],
      "js": [
        "hyperflow_boot.js",
        "hyperflow.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "https://global.hoymiles.com/*"
      ],
      "js": [
        "hoymiles.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_title": "TARS Vision Bridge — SLA & Hoymiles Lab",
    "default_popup": "popup.html"
  }
}
